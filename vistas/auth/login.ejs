<%- include('../partials/head') %>
<body style="display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #0b0f17;">
    <div style="background: #111622; padding: 40px; border-radius: 12px; border: 1px solid #262c36; width: 350px; color: #fff;">
        <h2 style="margin-bottom: 20px; text-align: center; color: #f0c36b;">Iniciar Sesión</h2>
        <form action="/login" method="POST">
            <div style="margin-bottom: 15px;">
                <label style="font-size: 12px; color: #94a3b8; display: block; margin-bottom: 5px;">Correo electrónico</label>
                <input type="email" name="email" required style="width: 100%; padding: 10px; background: #0b0f17; border: 1px solid #262c36; border-radius: 6px; color: #fff;">
            </div>
            <div style="margin-bottom: 20px;">
                <label style="font-size: 12px; color: #94a3b8; display: block; margin-bottom: 5px;">Contraseña</label>
                <input type="password" name="password" required style="width: 100%; padding: 10px; background: #0b0f17; border: 1px solid #262c36; border-radius: 6px; color: #fff;">
            </div>
            <button type="submit" style="width: 100%; background: #f0c36b; color: #000; padding: 10px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">Entrar</button>
        </form>
        <p style="text-align: center; margin-top: 15px; font-size: 12px; color: #94a3b8;">¿No tienes cuenta? <a href="/register" style="color: #f0c36b;">Regístrate</a></p>
    </div>
</body>
</html>